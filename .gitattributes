# The package is built on Linux and runs on a Linux controller. CRLF line
# endings break debian/rules there. So keep LF for every text file, on any OS.
#
# More about line endings:
# https://docs.github.com/en/get-started/getting-started-with-git/configuring-git-to-handle-line-endings

# IMPORTANT: do not use a wildcard like `* text=auto eol=lf`
# List every file or pattern here by hand

# Root specific files
.gitignore text=auto eol=lf
.gitattributes text=auto eol=lf
Jenkinsfile text=auto eol=lf
LICENSE text=auto eol=lf
pytest.ini text=auto eol=lf

# Folder ./debian
copyright text=auto eol=lf
changelog text=auto eol=lf
control text=auto eol=lf
rules text=auto eol=lf

# By file extension, in any folder
*.md text=auto eol=lf
*.py text=auto eol=lf
